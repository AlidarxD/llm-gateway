# Copy to .env (never commit it). Dev default needs no paid accounts.
GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway
GATEWAY_REDIS_URL=redis://redis:6379/0
GATEWAY_ENABLED_PROVIDERS=["fake","ollama"]
GATEWAY_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional, only for the "full" routing profile (config/routes.full.json):
# GATEWAY_ROUTES_FILE=config/routes.full.json
# GATEWAY_ENABLED_PROVIDERS=["anthropic","openai","openrouter","ollama"]
# GATEWAY_ANTHROPIC_API_KEY=
# GATEWAY_OPENAI_API_KEY=
# GATEWAY_OPENROUTER_API_KEY=
GRAFANA_ADMIN_PASSWORD=change-me
